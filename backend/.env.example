# Ví dụ về các biến môi trường cấu hình cho dự án (Sao chép thành file .env và thay đổi giá trị thực tế)
DJANGO_SECRET_KEY=your-django-secret-key-here
DJANGO_DEBUG=True
DJANGO_ENV=development

DB_NAME=housing_db
DB_USER=postgres
DB_PASSWORD=your-database-password-here
DB_HOST=localhost
DB_PORT=5432
REDIS_URL=redis://localhost:6379/1
